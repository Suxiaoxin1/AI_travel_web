# 数据库
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starwalk

# JWT
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Keys（仅后端使用）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
ZHIPU_API_KEY=your-zhipu-key
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
AGNES_API_KEY=your-agnes-key
AGNES_API_BASE=https://apihub.agnes-ai.com/v1

# 高德 Web 服务路线规划（仅后端使用，需要 Web 服务 API Key）
AMAP_WEB_SERVICE_KEY=your-amap-web-service-key
AMAP_WEB_SERVICE_BASE=https://restapi.amap.com/v3

# 对象存储（S3 兼容：本地 MinIO / 阿里云 OSS / AWS S3）
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=starwalk
S3_REGION=us-east-1
# S3_PUBLIC_URL=https://cdn.example.com  # 可选 CDN 域名
