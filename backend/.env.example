# 数据库
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starwalk

# JWT
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Keys（仅后端使用）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
ZHIPU_API_KEY=your-zhipu-key
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
# 手账图片分析：智谱视觉模型
ZHIPU_VISION_MODEL=glm-5.3-flash
# 手账生图：智谱官方 GLM-Image（文生图，不经中转站）
# 文档：https://docs.bigmodel.cn/cn/guide/models/image-generation/glm-image
ZHIPU_IMAGE_MODEL=glm-image
AGNES_API_KEY=your-agnes-or-kabuai-key
# 视频等能力仍可选用；手账分析/生图已改走智谱官方
AGNES_API_BASE=https://api.kabuai.cn/v1
# AGNES_API_BASE=https://apihub.agnes-ai.com/v1
# VOLO 相册成片：本地需安装 ffmpeg（Docker 镜像已内置）
# 旁白 TTS 后续再接入，当前为无旁白 Ken Burns 成片
# 生产 Docker：backend → film 容器用 http://film:3000
FILM_API_BASE=http://127.0.0.1:3000
# 万相兜底（优先管理后台「模型密钥」覆盖）
# DASHSCOPE_API_KEY=
# BAILIAN_WORKSPACE_ID=
# BAILIAN_REGION=cn-beijing

# 高德 Web 服务路线规划（仅后端使用，需要 Web 服务 API Key）
AMAP_WEB_SERVICE_KEY=your-amap-web-service-key
AMAP_WEB_SERVICE_BASE=https://restapi.amap.com/v3

# 对象存储（S3 兼容：本地 MinIO / 阿里云 OSS / AWS S3）
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=starwalk
S3_REGION=us-east-1
S3_ENABLED=true
# S3_PUBLIC_URL=https://cdn.example.com  # 可选 CDN 域名

# 首个管理员引导账号。账号首次成功登录后会授予管理员角色；随后应从生产环境变量删除。
# ADMIN_BOOTSTRAP_ACCOUNT=admin_user

# 标签悬停图搜（可选）。优先高德 POI 配图（复用 AMAP_WEB_SERVICE_KEY），
# 再 Wikimedia / Openverse；PEXELS / Unsplash 为海外兜底。
# PEXELS_API_KEY=
# UNSPLASH_ACCESS_KEY=
