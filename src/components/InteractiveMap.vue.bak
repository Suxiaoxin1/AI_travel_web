<template>
  <div class="map-wrapper" :class="{ 'map-shrinked': shrinked }">
    <div class="map-status" id="mapStatus">{{ statusText }}</div>
    <div class="province-tooltip" ref="tooltipRef" :class="{ visible: tooltipVisible }">
      <span class="tooltip-name">{{ tooltipName }}</span>
      <span class="tooltip-hint">点击探索</span>
    </div>
    <svg ref="svgRef" id="china-map-svg" :viewBox="'0 0 ' + VB_W + ' ' + VB_H" preserveAspectRatio="xMidYMid meet" class="map-svg"></svg>
  </div>
</template>
<script setup>
import { ref, onMounted, onUnmounted } from 'vue'
import * as d3 from 'd3'
import { feature } from 'topojson-client'
import { useMapStore } from '../stores/mapStore.js'
import { provinceData } from '../data/provinces.js'

const store = useMapStore()
const props = defineProps({ shrinked: Boolean })
const emit = defineEmits(['province-click'])

const VB_W = 1000, VB_H = 900
const PROVINCE_COORDINATES = {
  beijing:{name:'北京',center:[116.4074,39.9042],color:'#1A8A7A',code:'110000'},shanghai:{name:'上海',center:[121.4737,31.2304],color:'#0D6B5C',code:'310000'},
  sichuan:{name:'四川',center:[104.0657,30.6595],color:'#2EA89A',code:'510000'},yunnan:{name:'云南',center:[102.7123,25.0406],color:'#D4A84B',code:'530000'},
  xizang:{name:'西藏',center:[91.1322,29.6604],color:'#C23B22',code:'540000'},xinjiang:{name:'新疆',center:[87.6177,43.7928],color:'#D4A84B',code:'650000'},
  guangdong:{name:'广东',center:[113.2644,23.1291],color:'#0D6B5C',code:'440000'},fujian:{name:'福建',center:[119.3062,26.0745],color:'#1A8A7A',code:'350000'},
  zhejiang:{name:'浙江',center:[120.1536,30.2875],color:'#2EA89A',code:'330000'},jiangsu:{name:'江苏',center:[118.7674,32.0415],color:'#0D6B5C',code:'320000'},
  shandong:{name:'山东',center:[117.0009,36.6758],color:'#2EA89A',code:'370000'},henan:{name:'河南',center:[113.6654,34.7570],color:'#C23B22',code:'410000'},
  hubei:{name:'湖北',center:[114.2986,30.5844],color:'#1A8A7A',code:'420000'},hunan:{name:'湖南',center:[112.9823,28.1960],color:'#C23B22',code:'430000'},
  guangxi:{name:'广西',center:[108.3200,22.8240],color:'#2EA89A',code:'450000'},guizhou:{name:'贵州',center:[106.7135,26.5783],color:'#1A8A7A',code:'520000'},
  shaanxi:{name:'陕西',center:[108.9480,34.2632],color:'#C23B22',code:'610000'},gansu:{name:'甘肃',center:[103.8236,36.0580],color:'#D4A84B',code:'620000'},
  hainan:{name:'海南',center:[110.3593,18.7854],color:'#2EA89A',code:'460000'}
}
const svgRef=ref(null),tooltipRef=ref(null);const statusText=ref('加载中...'),tooltipVisible=ref(false),tooltipName=ref('')
let svg=null,projection=null,path=null,zoom=null,geoData=null,selectedProvince=null
function say(m){statusText.value=m;console.log('[Map]'+m)}
function getProvinceCenter(f){if(!projection||!f)return null;try{return path.centroid(f)}catch{return null}}
function hexToRgba(h,o){return`rgba(${parseInt(h.slice(1,3),16)},${parseInt(h.slice(3,5),16)},${parseInt(h.slice(5,7),16)},${o})`}
function getFill(c,o){const p=provinceData[c];return p&&p.color?hexToRgba(p.color,o||0.35):'rgba(26,138,122,0.35)'}
async function initMap(){if(!svgRef.value){say('SVG ref is null');return}
  svg=d3.select(svgRef.value);svg.selectAll('*').remove()
  try{svg.append('circle').attr('cx',500).attr('cy',450).attr('r',20).attr('fill','#1A8A7A');say('D3 OK');svg.selectAll('*').remove()}
  catch(e){say('D3 error: '+e.message);return}
  createProjection();createZoomBehavior();defineFilters();await loadGeoJSON();renderProvinceNodes();say('地图渲染完成！')}
function createProjection(){projection=d3.geoMercator().center([104,35]).scale(480).translate([VB_W/2,680]);path=d3.geoPath().projection(projection)}
function createZoomBehavior(){zoom=d3.zoom().scaleExtent([1,8]).on('zoom',(e)=>{svg.selectAll('.map-group').attr('transform',e.transform);svg.selectAll('.node-group').attr('transform',e.transform)});svg.call(zoom)}
function defineFilters(){const d=svg.append('defs')
  const o=d.append('filter').attr('id','og').attr('x','-50%').attr('y','-50%').attr('width','200%').attr('height','200%')
  o.append('feDropShadow').attr('dx',0).attr('dy',0).attr('stdDeviation',4).attr('flood-color','#D4A84B').attr('flood-opacity',0.4)
  o.append('feDropShadow').attr('dx',0).attr('dy',0).attr('stdDeviation',8).attr('flood-color','#D4A84B').attr('flood-opacity',0.15)
  const n=d.append('filter').attr('id','ng').attr('x','-100%').attr('y','-100%').attr('width','300%').attr('height','300%')
  n.append('feDropShadow').attr('dx',0).attr('dy',0).attr('stdDeviation',5).attr('flood-color','#1A8A7A').attr('flood-opacity',0.5)
  const h=d.append('filter').attr('id','hg').attr('x','-100%').attr('y','-100%').attr('width','300%').attr('height','300%')
  h.append('feDropShadow').attr('dx',0).attr('dy',0).attr('stdDeviation',8).attr('flood-color','#D4A84B').attr('flood-opacity',0.7)}
async function loadGeoJSON(){let data=null
  for(const s of[{n:'代理',u:'/api/map'},{n:'直连',u:'https://geo.datav.aliyun.com/areas_v3/bound/100000_full.json'}]){
    try{say('加载: '+s.n);const r=await fetch(s.u);if(!r.ok)throw new Error('HTTP '+r.status);data=await r.json();say(s.n+' OK ('+(JSON.stringify(data).length/1024).toFixed(0)+'KB)');break}
    catch(e){say(s.n+': '+e.message)}}
  svg.selectAll('*').remove()
  if(!data){say('数据源失败，使用备用节点');renderFallbackNodes();return}
  try{let g;if(data.objects){const k=Object.keys(data.objects)[0];g=feature(data,data.objects[k])}else if(data.type==='FeatureCollection')g=data;else throw new Error('未知格式')
    geoData=g;const f=g.features.filter(f=>f.properties&&(f.properties.adcode||f.properties.name));say('省份: '+f.length);renderMapPaths(f)}
  catch(e){say('渲染错误: '+e.message);renderFallbackNodes()}}
function renderMapPaths(feats){const mg=svg.append('g').attr('class','map-group')
  mg.selectAll('path.province-area').data(feats).join('path').attr('class','province-area')
    .attr('d',d=>{try{return path(d)}catch{return''}})
    .attr('fill',d=>getFill(d.properties.adcode||d.properties.code||'',0.35))
    .attr('stroke',d=>{const p=provinceData[d.properties.adcode||d.properties.code||''];return p&&p.color?hexToRgba(p.color,0.5):'rgba(26,138,122,0.5)'}).attr('stroke-width',0.8).style('cursor','pointer')
    .on('mouseenter',function(ev,d){d3.select(this).attr('fill',f=>getFill(f.properties.adcode||f.properties.code||'',0.6)).attr('stroke-width',1.5).attr('stroke','#D4A84B');showTooltip(d.properties?.name||'未知',ev)})
    .on('mouseleave',function(){d3.select(this).attr('fill',f=>getFill(f.properties.adcode||f.properties.code||'',0.35)).attr('stroke-width',0.8).attr('stroke',f=>{const p=provinceData[f.properties.adcode||f.properties.code||''];return p&&p.color?hexToRgba(p.color,0.5):'rgba(26,138,122,0.5)'});hideTooltip()})
  mg.selectAll('path.outline').data(feats).join('path').attr('class','outline').attr('d',d=>{try{return path(d)}catch{return''}}).attr('fill','none').attr('stroke','#D4A84B').attr('stroke-width',1.2).attr('filter','url(#og)').style('pointer-events','none')
  feats.forEach(f=>{const n=f.properties?.name||f.properties?.NAME;if(!n)return;const c=getProvinceCenter(f);if(!c||c.some(isNaN))return
    svg.append('text').attr('x',c[0]).attr('y',c[1]).attr('text-anchor','middle').attr('dominant-baseline','central').attr('fill','#5C5C6E').attr('font-size','10').attr('font-weight','500').attr('font-family','"Noto Sans SC",sans-serif').style('pointer-events','none').style('text-shadow','0 0 4px rgba(248,246,240,0.9)').text(n)})}
function renderProvinceNodes(){const ng=svg.append('g').attr('class','node-group')
  Object.entries(PROVINCE_COORDINATES).forEach(([id,data])=>{const sc=projection(data.center);if(!sc||sc.some(isNaN))return;const[x,y]=sc
    const node=ng.append('g').attr('class','province-node').attr('data-province-id',id).attr('transform','translate('+x+','+y+')').style('cursor','pointer')
    node.append('circle').attr('class','node-glow').attr('r',18).attr('fill','none').attr('stroke','#D4A84B').attr('stroke-width',0.6).attr('opacity',0.25)
    node.append('circle').attr('class','planet-core').attr('r',8).attr('fill',data.color).style('filter','url(#ng)')
    node.append('circle').attr('cx',-2).attr('cy',-2).attr('r',2).attr('fill','rgba(255,255,255,0.3)')
    node.append('text').attr('class','province-label').attr('y',20).attr('text-anchor','middle').attr('font-size','10px').attr('font-family',"'Noto Sans SC',sans-serif").attr('fill','#5C5C6E').attr('font-weight','500').text(data.name)
    node.on('mouseenter',function(ev){d3.select(this).select('.node-glow').attr('stroke-width',1.2).attr('opacity',0.5);d3.select(this).select('.planet-core').attr('r',10).style('filter','url(#hg)');d3.select(this).select('.province-label').attr('fill','#1A1A2E').attr('font-weight',600);showTooltip(data.name,ev)}).on('mouseleave',function(){d3.select(this).select('.node-glow').attr('stroke-width',0.6).attr('opacity',0.25);d3.select(this).select('.planet-core').attr('r',8).style('filter','url(#ng)');d3.select(this).select('.province-label').attr('fill','#5C5C6E').attr('font-weight',500);hideTooltip()}).on('click',function(){handleProvinceClick(id,data)})})}
function renderFallbackNodes(){const ng=svg.append('g').attr('class','node-group')
  Object.entries(PROVINCE_COORDINATES).forEach(([id,data])=>{const sc=projection(data.center);if(!sc||sc.some(isNaN))return;const[x,y]=sc
    const node=ng.append('g').attr('class','province-node').attr('data-province-id',id).attr('transform','translate('+x+','+y+')').style('cursor','pointer')
    node.append('circle').attr('r',10).attr('fill',data.color).attr('opacity',0.8).attr('stroke','#fff').attr('stroke-width',1.5)
    node.append('text').attr('y',-16).attr('text-anchor','middle').attr('fill','#5C5C6E').attr('font-size','11').attr('font-weight','600').attr('font-family','"Noto Sans SC",sans-serif').text(data.name)
    node.on('click',function(){handleProvinceClick(id,data)})})}
function showTooltip(name,event){tooltipName.value=name;tooltipVisible.value=true;if(tooltipRef.value){const r=svgRef.value.getBoundingClientRect();tooltipRef.value.style.left=(event.clientX-r.left+20)+'px';tooltipRef.value.style.top=(event.clientY-r.top-30)+'px'}}
function hideTooltip(){tooltipVisible.value=false}
function handleProvinceClick(id,data){console.log('点击省份:',data.name,id);selectedProvince=id
  svg.selectAll('.province-node').classed('selected',false).classed('dimmed',true);svg.select('[data-province-id="'+id+'"]').classed('selected',true).classed('dimmed',false)
  if(data.code)store.selectProvince(data.code);emit('province-click',{id:id,...data})}
function clearSelection(){selectedProvince=null;svg.selectAll('.province-node').classed('selected',false).classed('dimmed',false)}
function selectProvince(id){const d=PROVINCE_COORDINATES[id];if(d)handleProvinceClick(id,d)}
function flyToProvince(id,dur=1000){const d=PROVINCE_COORDINATES[id];if(!d)return;const tp=projection(d.center);if(!tp)return;svg.transition().duration(dur).call(zoom.transform,d3.zoomIdentity.translate(VB_W/2-tp[0]*1,VB_H/2-tp[1]*1).scale(1.5))}
function resetView(dur=800){clearSelection();svg.transition().duration(dur).call(zoom.transform,d3.zoomIdentity)}
function getScreenCoords(id){const d=PROVINCE_COORDINATES[id];return d?projection(d.center):null}
defineExpose({clearSelection,selectProvince,flyToProvince,resetView,getScreenCoords})
onMounted(()=>{initMap()});onUnmounted(()=>{if(svg){svg.on('.zoom',null);svg.selectAll('*').remove()};geoData=null;selectedProvince=null})
</script>
<style scoped>
@keyframes selectedPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.1)}}
:deep(.province-node.selected){animation:selectedPulse 1.5s ease-in-out infinite}:deep(.province-node.dimmed){opacity:0.25;pointer-events:none}
.map-wrapper{position:relative;width:100%;height:100%;overflow:hidden;background:transparent;transition:width 0.5s cubic-bezier(0.4,0,0.2,1)}
.map-wrapper.map-shrinked{width:65%}
.map-status{position:absolute;top:8px;left:8px;z-index:99;font-size:12px;font-family:'Noto Sans SC',sans-serif;background:rgba(248,246,240,0.9);backdrop-filter:blur(8px);padding:6px 12px;border-radius:6px;border:1px solid #D4A84B;color:#1A1A2E}
.province-tooltip{position:absolute;z-index:100;background:#FFFFFF;backdrop-filter:blur(12px);border:1px solid #D4A84B;border-radius:8px;padding:8px 14px;pointer-events:none;opacity:0;transform:translateY(5px);transition:opacity 0.2s ease,transform 0.2s ease;box-shadow:0 4px 20px rgba(212,168,75,0.15)}
.province-tooltip.visible{opacity:1;transform:translateY(0)}
.province-tooltip .tooltip-name{display:block;color:#1A1A2E;font-size:13px;font-weight:600;font-family:'Noto Sans SC',sans-serif}
.province-tooltip .tooltip-hint{display:block;color:#1A8A7A;font-size:11px;margin-top:2px;font-family:'Noto Sans SC',sans-serif}
.map-svg{width:100%;height:100%;display:block}
</style>
